      "source": [
        "## 矢吹先生だけが読める暗号ファイルの作成\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "5cb4258f"
      },
      "source": [
        "# 1. 矢吹先生の公開鍵をダウンロードする。\n",
        "!wget -O yabuki-public.pem https://raw.githubusercontent.com/taroyabuki/LI/refs/heads/main/yabuki-public.pem\n",
        "\n",
        "# ダウンロードした公開鍵の内容を確認\n",
        "!cat yabuki-public.pem"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "06557fe5"
      },
      "source": [
        "# 2. テキストファイル report を作成する。内容は学籍番号 `26G3138`。\n",
        "!printf \"26G3138\\n\" > report\n",
        "\n",
        "# 作成した report ファイルの内容を確認\n",
        "!cat report"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "f4814b3a"
      },
      "source": [
        "# 3. 矢吹先生の公開鍵を使って、report を暗号化する。暗号化されたファイルの名前は report-secret。\n",
        "!openssl pkeyutl -encrypt -pubin -inkey yabuki-public.pem -in report -out report-secret\n",
        "\n",
        "# 暗号化されたファイル (report-secret) を確認する (バイナリデータなので base64 でエンコードして表示)\n",
        "!base64 report-secret"
      ],
      "execution_count": null,
      "outputs": []
    }
  ]
